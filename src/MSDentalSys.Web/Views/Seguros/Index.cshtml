@model IReadOnlyList<MSDentalSys.Data.Models.Seguro>
@{
    ViewData["Title"] = "Seguros";
}

<div class="service-page">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Cat&aacute;logo administrativo</p>
            <h1>Seguros m&eacute;dicos</h1>
            <p>Administra las aseguradoras disponibles para el registro de pacientes.</p>
        </div>
        <a asp-action="Create" class="btn btn-ms-primary"><span aria-hidden="true">+</span> Nuevo seguro</a>
    </div>

    <div class="service-toolbar">
        <span class="service-count">@Model.Count seguro(s)</span>
    </div>

    <div class="service-table-card">
        <div class="table-responsive">
            <table class="table service-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th>Fecha de creaci&oacute;n</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var seguro in Model)
                    {
                        <tr>
                            <td><strong>@seguro.Nombre</strong></td>
                            <td>
                                <span class="user-status @(seguro.Estado ? "user-status-active" : "user-status-inactive")">
                                    @(seguro.Estado ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>@seguro.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@seguro.SeguroId" class="btn btn-sm btn-user-action">Ver</a>
                                <a asp-action="Edit" asp-route-id="@seguro.SeguroId" class="btn btn-sm btn-user-action">Editar</a>
                                @if (seguro.Estado)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@seguro.SeguroId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-user-action btn-user-danger">Desactivar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@seguro.SeguroId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-user-action btn-user-activate">Activar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="empty-table">No hay seguros m&eacute;dicos registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
