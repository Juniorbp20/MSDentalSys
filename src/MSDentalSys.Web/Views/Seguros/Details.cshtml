@model MSDentalSys.Data.Models.Seguro
@{
    ViewData["Title"] = "Detalle de seguro";
}

<div class="service-page">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Cat&aacute;logo administrativo</p>
            <h1>Detalle de seguro</h1>
            <p>Informaci&oacute;n registrada de la aseguradora.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-light">Volver</a>
            <a asp-action="Edit" asp-route-id="@Model.SeguroId" class="btn btn-ms-primary">Editar</a>
        </div>
    </div>

    <div class="service-detail-card">
        <div class="service-detail-header">
            <div>
                <h2>@Model.Nombre</h2>
                <p>Seguro m&eacute;dico</p>
            </div>
            <span class="user-status @(Model.Estado ? "user-status-active" : "user-status-inactive")">
                @(Model.Estado ? "Activo" : "Inactivo")
            </span>
        </div>
        <dl class="service-detail-grid">
            <div><dt>Nombre</dt><dd>@Model.Nombre</dd></div>
            <div><dt>Fecha de creaci&oacute;n</dt><dd>@Model.FechaCreacion.ToString("dd/MM/yyyy")</dd></div>
        </dl>
    </div>
</div>
